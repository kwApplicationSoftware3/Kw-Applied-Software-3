@page "/review/{TeamId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Enums
@inject ActivityClientService ActivityService
@inject NavigationManager Nav

<div class="container">
    <div class="review-card">
        @if (isLoading)
        {
            <div class="loading-state">평가 대상 팀원 정보를 불러오는 중입니다...</div>
        }
        else if (targetResponse == null || !targetResponse.IsSuccess)
        {
            <div class="error-state">
                <p>@(targetResponse?.Message ?? "평가 정보를 불러오지 못했습니다.")</p>
                <button class="btn-secondary" @onclick="GoBack">돌아가기</button>
            </div>
        }
        else
        {
            <header class="review-header">
                <h2 class="review-title">팀원 상호 평가</h2>
                <p class="review-subtitle">함께 프로젝트를 진행한 팀원들에게 따뜻한 피드백을 남겨주세요.</p>
                <div class="project-info-badge">프로젝트 번호: #@targetResponse.PostId</div>
            </header>

            <div class="team-list">
                @if (reviewModels != null)
                {
                    @foreach (var member in reviewModels)
                    {
                        <div class="member-review-item card">
                            <div class="member-profile">
                                <div class="avatar">@(member.Nickname?[0] ?? 'U')</div>
                                <div class="member-info">
                                    <span class="member-name">@member.Nickname</span>
                                    <span class="member-role">@member.Role</span>
                                </div>
                            </div>

                            <div class="rating-section">
                                <div class="rating-group">
                                    <label>협업 신뢰도 (1~5점)</label>
                                    <div class="stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            int starIndex = i;
                                            <span class="star @(member.ReliabilityScore >= starIndex ? "filled" : "")" 
                                                  @onclick="() => member.ReliabilityScore = starIndex">★</span>
                                        }
                                    </div>
                                </div>

                                <div class="rating-group">
                                    <label>기술 기여도 (1~5점)</label>
                                    <div class="stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            int starIndex = i;
                                            <span class="star @(member.ContributionScore >= starIndex ? "filled" : "")" 
                                                  @onclick="() => member.ContributionScore = starIndex">★</span>
                                        }
                                    </div>
                                </div>

                                <div class="rating-group">
                                    <label>의사소통 (1~5점)</label>
                                    <div class="stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            int starIndex = i;
                                            <span class="star @(member.CommunicationScore >= starIndex ? "filled" : "")" 
                                                  @onclick="() => member.CommunicationScore = starIndex">★</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-2">@errorMessage</div>
            }

            <div class="form-actions">
                <button class="btn-later" @onclick="GoBack" disabled="@isSubmitting">나중에 하기</button>
                <button class="btn-primary" @onclick="SubmitReviews" disabled="@isSubmitting">
                    @(isSubmitting ? "제출 중..." : "평가 완료 및 제출")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int TeamId { get; set; }
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private GetReviewTargetResponse? targetResponse;
    private List<InternalReviewModel> reviewModels = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadReviewTargets();
    }

    private async Task LoadReviewTargets()
    {
        isLoading = true;
        try
        {
            targetResponse = await ActivityService.GetReviewTargetAsync(TeamId);
            if (targetResponse?.IsSuccess == true && targetResponse.Members != null)
            {
                reviewModels = targetResponse.Members.Select(t => new InternalReviewModel
                {
                    UserId = t.UserId,
                    Nickname = t.Nickname,
                    Role = t.Position ?? t.Role.ToString(),
                    ReliabilityScore = 5,
                    ContributionScore = 5,
                    CommunicationScore = 5
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "정보를 불러오는 중 오류가 발생했습니다: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitReviews()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new SubmitReviewRequest 
            { 
                Reviews = reviewModels.Select(m => new ReviewDto 
                { 
                    UserId = m.UserId,
                    ReliabilityScore = m.ReliabilityScore,
                    ContributionScore = m.ContributionScore,
                    CommunicationScore = m.CommunicationScore
                }).ToList() 
            };
            var result = await ActivityService.SubmitReviewAsync(TeamId, request);

            if (result?.IsSuccess == true)
            {
                Nav.NavigateTo("/profile");
            }
            else
            {
                errorMessage = result?.Message ?? "평가 제출에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "서버 통신 중 오류가 발생했습니다: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/my-activities");

    public class InternalReviewModel
    {
        public int UserId { get; set; }
        public string? Nickname { get; set; }
        public string? Role { get; set; }
        public float ReliabilityScore { get; set; }
        public float ContributionScore { get; set; }
        public float CommunicationScore { get; set; }
    }
}

<style>
    .review-card { max-width: 800px; margin: 3rem auto; }
    .review-header { text-align: center; margin-bottom: 3rem; }
    .review-title { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
    .review-subtitle { color: #6b7280; }
    .project-info-badge { display: inline-block; margin-top: 1rem; padding: 0.5rem 1.5rem; background: #eff6ff; color: #1e40af; border-radius: 2rem; font-weight: 700; }
    .team-list { display: flex; flex-direction: column; gap: 1.5rem; }
    .member-review-item { display: flex; flex-direction: column; gap: 1.5rem; padding: 2rem; }
    .member-profile { display: flex; align-items: center; gap: 1rem; }
    .avatar { width: 48px; height: 48px; background: #3b82f6; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; }
    .member-name { display: block; font-weight: 700; font-size: 1.1rem; }
    .member-role { font-size: 0.85rem; color: #6b7280; }
    .rating-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
    .rating-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem; color: #4b5563; }
    .stars { font-size: 1.5rem; color: #d1d5db; cursor: pointer; }
    .star.filled { color: #fbbf24; }
    .form-actions { display: flex; justify-content: center; gap: 1rem; margin-top: 3rem; }
    .btn-later { padding: 0.75rem 2rem; border-radius: 0.5rem; font-size: 1rem; font-weight: 600; cursor: pointer; border: 2px solid #d1d5db; background: #ffffff; color: #4b5563; transition: background 0.2s, border-color 0.2s; }
    .btn-later:hover:not(:disabled) { background: #f3f4f6; border-color: #9ca3af; }
    .btn-later:disabled { opacity: 0.5; cursor: not-allowed; }
    .loading-state, .error-state { text-align: center; padding: 5rem; color: #6b7280; }
    .alert-danger { background: #fef2f2; color: #991b1b; padding: 1rem; border-radius: 0.5rem; text-align: center; }
    .mt-2 { margin-top: 1rem; }
</style>
