@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Entities
@inject ProfileClientService ProfileService
@inject PostClientService PostService
@inject NavigationManager Nav

<div class="container">
    @if (profile == null)
    {
        <div class="loading-state">프로필 정보를 불러오는 중입니다...</div>
    }
    else
    {
        <div class="profile-header card">
            <div class="profile-info">
                <div class="avatar">@(profile.Nickname?[0] ?? 'U')</div>
                <div>
                    <h2>@profile.Nickname 님</h2>
                    <p>자기소개: @(profile.Bio ?? "정보가 없습니다.")</p>
                    <div class="tag-cloud">
                        @if (availableTags != null && profile.UserTagIds != null)
                        {
                            @foreach (var tagId in profile.UserTagIds)
                            {
                                var tagName = availableTags.FirstOrDefault(t => t.Id == tagId)?.Name ?? tagId.ToString();
                                <span class="tag">#@tagName</span>
                            }
                        }
                    </div>
                </div>
            </div>
            <button class="btn-secondary" @onclick="HandleEdit">프로필 수정</button>
        </div>

        <div class="profile-stats grid-2">
            <div class="card">
                <h3>상호 평가 요약</h3>
                <p class="section-desc">팀원들이 평가한 나의 평균 점수입니다.</p>
                <div class="stat-item">
                    <span class="stat-label">협업 신뢰도</span>
                    <div class="progress-bar"><div class="progress" style="width: @(profile.ReliabilityScore * 20)%"></div></div>
                    <span class="stat-value">@profile.ReliabilityScore.ToString("F1")</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">기술 기여도</span>
                    <div class="progress-bar"><div class="progress" style="width: @(profile.ContributionScore * 20)%"></div></div>
                    <span class="stat-value">@profile.ContributionScore.ToString("F1")</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">의사소통</span>
                    <div class="progress-bar"><div class="progress" style="width: @(profile.CommunicationScore * 20)%"></div></div>
                    <span class="stat-value">@profile.CommunicationScore.ToString("F1")</span>
                </div>
            </div>

            <div class="card">
                <h3>참여 프로젝트</h3>
                @if (profile.MyTeams == null || profile.MyTeams.Count == 0)
                {
                    <p class="empty-text">아직 참여한 프로젝트가 없습니다.</p>
                }
                else
                {
                    <ul class="activity-list">
                        @foreach (var project in profile.MyTeams)
                        {
                            <li>
                                <strong>@project.TeamName</strong>
                                <span>역할: @project.Role (@(project.Position ?? "미지정"))</span>
                                <span class="status-done">@project.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@code {
    private GetProfileResponse? profile;
    private List<Tag>? availableTags;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await ProfileService.GetProfileAsync();
            availableTags = await PostService.GetTagsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
    }

    private void HandleEdit() { }
}

<style>
    .profile-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; margin-top: 2rem; }
    .profile-info { display: flex; gap: 2rem; align-items: center; }
    .avatar { width: 100px; height: 100px; background: #3b82f6; color: white; font-size: 3rem; font-weight: 800; display: flex; justify-content: center; align-items: center; border-radius: 50%; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
    .tag { background: #f3f4f6; color: #4b5563; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .section-desc { color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem; }
    .stat-item { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .stat-label { width: 100px; font-size: 0.9rem; font-weight: 600; }
    .progress-bar { flex: 1; height: 8px; background: #f3f4f6; border-radius: 4px; overflow: hidden; }
    .progress { height: 100%; background: #3b82f6; }
    .stat-value { font-weight: 700; color: #3b82f6; width: 40px; text-align: right; }
    .activity-list { list-style: none; padding: 0; }
    .activity-list li { padding: 1rem 0; border-bottom: 1px solid #f3f4f6; display: flex; flex-direction: column; gap: 0.25rem; }
    .activity-list li:last-child { border-bottom: none; }
    .status-done { font-size: 0.75rem; background: #eff6ff; color: #1d4ed8; padding: 0.125rem 0.5rem; border-radius: 4px; width: fit-content; }
    .btn-secondary { background: #f3f4f6; border: 1px solid #d1d5db; color: #374151; padding: 0.5rem 1rem; border-radius: 0.5rem; cursor: pointer; font-weight: 600; }
    .btn-secondary:hover { background: #e5e7eb; }
    .loading-state { text-align: center; padding: 5rem; color: #6b7280; }
    .empty-text { color: #9ca3af; text-align: center; padding: 2rem; }
</style>
