@page "/signup"
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Entities
@inject AuthClientService AuthService
@inject PostClientService PostService
@inject NavigationManager Nav

<div class="container">
    <div class="auth-card">
        <h2 class="auth-title">회원가입</h2>
        <p class="auth-subtitle">팀 매칭 서비스에 오신 것을 환영합니다.</p>

        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label for="email">이메일</label>
                <InputText id="email" class="form-control" @bind-Value="registerModel.Email" placeholder="example@university.ac.kr" />
                <ValidationMessage For="@(() => registerModel.Email)" class="text-danger" />
            </div>
            
            <div class="form-group">
                <label for="nickname">닉네임</label>
                <InputText id="nickname" class="form-control" @bind-Value="registerModel.Nickname" placeholder="활동할 닉네임을 입력하세요" />
                <ValidationMessage For="@(() => registerModel.Nickname)" class="text-danger" />
            </div>

            <div class="form-group">
                <label for="password">비밀번호</label>
                <InputText type="password" id="password" class="form-control" @bind-Value="registerModel.Password" placeholder="비밀번호를 입력하세요" />
                <ValidationMessage For="@(() => registerModel.Password)" class="text-danger" />
            </div>

            <div class="form-group">
                <label>관심 기술 스택 (다중 선택 가능)</label>
                <div class="tag-selection">
                    @if (availableTags == null)
                    {
                        <span>태그를 불러오는 중...</span>
                    }
                    else
                    {
                        @foreach (var tag in availableTags)
                        {
                            <button type="button" class="tag @(registerModel.SelectedTagIds.Contains(tag.Id) ? "active" : "")" 
                                  @onclick="() => ToggleTag(tag.Id)">
                                #@tag.Name
                            </button>
                        }
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button type="submit" class="btn-primary mt-2" disabled="@isSubmitting">
                @(isSubmitting ? "처리 중..." : "가입 완료")
            </button>
            
            <div class="auth-links">
                <span>이미 계정이 있으신가요?</span>
                <a href="/login" class="link-primary">로그인</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();
    private string? errorMessage;
    private bool isSubmitting = false;
    private List<Tag>? availableTags;

    protected override async Task OnInitializedAsync()
    {
        try { availableTags = await PostService.GetTagsAsync(); }
        catch { availableTags = []; }
    }

    private void ToggleTag(int tagId)
    {
        if (registerModel.SelectedTagIds.Contains(tagId)) registerModel.SelectedTagIds.Remove(tagId);
        else registerModel.SelectedTagIds.Add(tagId);
    }

    private async Task HandleRegister()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.RegisterAsync(registerModel);
            if (result != null && result.IsSuccess) Nav.NavigateTo("/login");
            else errorMessage = result?.Message ?? "회원가입 실패";
        }
        catch { errorMessage = "서버 통신 오류"; }
        finally { isSubmitting = false; }
    }
}

<style>
    .auth-card { max-width: 500px; margin: 2rem auto; padding: 2.5rem; background: white; border: 1px solid #e5e7eb; border-radius: 1rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
    .auth-title { font-size: 1.75rem; font-weight: 700; text-align: center; margin-bottom: 0.5rem; }
    .auth-subtitle { text-align: center; color: #6b7280; margin-bottom: 2rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
    .form-control { padding: 0.75rem 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; font-size: 1rem; }
    .tag-selection { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0.5rem 0; }
    .tag { cursor: pointer; padding: 0.25rem 0.75rem; border-radius: 999px; background: #f3f4f6; color: #4b5563; font-size: 0.85rem; border: 1px solid transparent; }
    .tag.active { background: #eff6ff; color: #3b82f6; border-color: #3b82f6; }
    .btn-primary { background: #3b82f6; color: white; border: none; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; width: 100%; }
    .alert-danger { background: #fef2f2; color: #991b1b; padding: 0.75rem; border-radius: 0.5rem; margin: 1rem 0; }
    .auth-links { text-align: center; margin-top: 1.5rem; font-size: 0.9rem; }
    .link-primary { color: #3b82f6; text-decoration: none; font-weight: 600; margin-left: 0.5rem; }
</style>
