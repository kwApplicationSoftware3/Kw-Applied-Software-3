@page "/my-activities"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Enums
@inject ActivityClientService ActivityService
@inject NavigationManager Nav

<div class="container">
    <header class="activity-header">
        <h2 class="page-title">내 활동 관리</h2>
        <div class="tab-menu">
            <button class="tab-btn @(activeTab == "posts" ? "active" : "")" @onclick='() => activeTab = "posts"'>내 모집글</button>
             <button class="tab-btn @(activeTab == "apps" ? "active" : "")" @onclick='() => activeTab = "apps"'>지원 현황</button>
            <button class="tab-btn @(activeTab == "teams" ? "active" : "")" @onclick='() => activeTab = "teams"'>참여 팀</button>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading-state">데이터를 불러오는 중입니다...</div>
    }
    else if (activities == null)
    {
        <div class="error-state">데이터를 불러오지 못했습니다.</div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-info mb-4">@statusMessage</div>
        }

        @if (activeTab == "posts")
        {
            <section class="activity-section">
                <div class="section-header">
                    <h3>내가 올린 모집글 (@activities.MyPosts.Count)</h3>
                    <button class="btn-primary-sm" @onclick='() => Nav.NavigateTo("/create-post")'>+ 새 글 쓰기</button>
                </div>
                <div class="activity-list">
                    @if (activities.MyPosts.Count == 0)
                    {
                        <p class="empty-text">작성한 모집글이 없습니다.</p>
                    }
                    @foreach (var post in activities.MyPosts)
                    {
                        <div class="activity-card card">
                            <div class="card-content">
                                <span class="status-badge @(post.Status == PostStatus.Recruiting ? "active" : "closed")">
                                    @(post.Status == PostStatus.Recruiting ? "모집중" : "모집완료")
                                </span>
                                <h4 class="post-title">@post.Title</h4>
                                <p class="post-info">지원자: <span class="highlight">@post.Applications 명</span> | 작성일: @post.CreatedAt.ToShortDateString()</p>
                            </div>
                            <div class="card-actions">
                                <button class="btn-outline" @onclick='() => Nav.NavigateTo($"/post-detail/{post.PostId}")'>상세보기</button>
                                @if (post.Status == PostStatus.Recruiting)
                                {
                                    <button class="btn-outline danger" @onclick="() => HandleClosePost(post.PostId)" disabled="@isProcessing">모집종료</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else if (activeTab == "apps")
        {
            <section class="activity-section">
                <div class="section-header">
                    <h3>내가 지원한 프로젝트 (@activities.MyApplications.Count)</h3>
                </div>
                <div class="activity-list">
                    @if (activities.MyApplications.Count == 0)
                    {
                        <p class="empty-text">지원한 프로젝트가 없습니다.</p>
                    }
                    @foreach (var app in activities.MyApplications)
                    {
                        <div class="activity-card card">
                            <div class="card-content">
                                <span class="status-badge @app.Status.ToString().ToLower()">
                                    @(app.Status switch {
                                        ApplicationStatus.Pending => "대기중",
                                        ApplicationStatus.Accepted => "수락됨",
                                        ApplicationStatus.Rejected => "거절됨",
                                        _ => app.Status.ToString()
                                    })
                                </span>
                                <h4 class="post-title">@app.Title</h4>
                                <p class="post-info">지원일: @app.CreatedAt.ToShortDateString()</p>
                            </div>
                            <div class="card-actions">
                                <button class="btn-outline" @onclick='() => Nav.NavigateTo($"/post-detail/{app.PostId}")'>글 보기</button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else if (activeTab == "teams")
        {
            <section class="activity-section">
                <div class="section-header">
                    <h3>참여 중인 팀 (@activities.MyTeams.Count)</h3>
                </div>
                <div class="activity-list">
                    @if (activities.MyTeams.Count == 0)
                    {
                        <p class="empty-text">참여 중인 팀이 없습니다.</p>
                    }
                    @foreach (var team in activities.MyTeams)
                    {
                        <div class="activity-card card">
                            <div class="card-content">
                                <h4 class="post-title">@team.TeamName</h4>
                            </div>
                            <div class="card-actions">
                                @if (!team.IsEnded)
                                {
                                    <button class="btn-primary-sm" @onclick='() => Nav.NavigateTo($"/team/{team.TeamId}")'>팀 공간 입장</button>
                                }
                                @if (team.IsEnded && !team.IsEvaluated)
                                {
                                    <button class="btn-outline" @onclick='() => Nav.NavigateTo($"/review/{team.TeamId}")'>팀원 평가</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private string activeTab = "posts";
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? statusMessage;
    private GetMyActivitiesResponse? activities;

    protected override async Task OnInitializedAsync()
    {
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        isLoading = true;
        try
        {
            activities = await ActivityService.GetMyActivitiesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleClosePost(int postId)
    {
        if (isProcessing) return;
        
        isProcessing = true;
        statusMessage = "모집 종료 처리 중입니다...";
        
        try
        {
            var result = await ActivityService.ClosePostAsync(new ClosePostRequest { PostId = postId });
            if (result?.IsSuccess == true)
            {
                statusMessage = "모집이 성공적으로 종료되어 팀이 생성되었습니다.";
                await LoadActivities();
            }
            else
            {
                statusMessage = "오류: " + (result?.Message ?? "모집 종료에 실패했습니다.");
            }
        }
        catch
        {
            statusMessage = "서버 통신 중 오류가 발생했습니다.";
        }
        finally
        {
            isProcessing = false;
        }
    }
}

<style>
    .activity-header { margin-bottom: 2.5rem; border-bottom: 1px solid #e5e7eb; margin-top: 2rem; }
    .page-title { font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem; }
    .tab-menu { display: flex; gap: 2rem; }
    .tab-btn { padding: 0.75rem 0.5rem; background: none; border: none; font-weight: 600; color: #6b7280; cursor: pointer; border-bottom: 3px solid transparent; transition: all 0.2s; }
    .tab-btn.active { color: #3b82f6; border-bottom-color: #3b82f6; }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .activity-list { display: flex; flex-direction: column; gap: 1rem; }
    .activity-card { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; }
    .post-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem; }
    .post-info { font-size: 0.875rem; color: #6b7280; }
    .highlight { color: #3b82f6; font-weight: 700; }
    .status-badge { display: inline-block; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 0.25rem; margin-bottom: 0.5rem; }
    .status-badge.active { background: #dcfce7; color: #166534; }
    .status-badge.closed { background: #f3f4f6; color: #6b7280; }
    .status-badge.pending { background: #fef9c3; color: #854d0e; }
    .status-badge.accepted { background: #dbeafe; color: #1e40af; }
    .status-badge.rejected { background: #fee2e2; color: #991b1b; }
    .card-actions { display: flex; gap: 0.5rem; }
    .btn-primary-sm { background: #3b82f6; color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.875rem; }
    .btn-outline { background: white; border: 1px solid #e5e7eb; padding: 0.5rem 1rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; font-size: 0.875rem; }
    .btn-outline.danger { color: #ef4444; }
    .btn-outline.danger:hover { background: #fef2f2; border-color: #ef4444; }
    .loading-state, .error-state { text-align: center; padding: 5rem; color: #6b7280; }
    .empty-text { color: #9ca3af; text-align: center; padding: 2rem; border: 1px dashed #e5e7eb; border-radius: 0.5rem; }
    .alert-info { background: #eff6ff; color: #1e40af; padding: 1rem; border-radius: 0.5rem; border: 1px solid #dbeafe; }
</style>
