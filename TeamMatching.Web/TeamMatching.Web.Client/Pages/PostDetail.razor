@page "/post-detail/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Entities
@inject PostClientService PostService
@inject NavigationManager Nav

<div class="container">
    @if (post == null)
    {
        <div class="loading-state">게시글을 불러오는 중입니다...</div>
    }
    else
    {
        <div class="detail-layout">
            <main class="detail-main">
                <div class="card">
                    <nav class="breadcrumb" @onclick='() => Nav.NavigateTo("/")' style="cursor:pointer;">게시판 > 프로젝트 모집</nav>
                    <h1 class="detail-title">@post.Title</h1>
                    <hr />
                    <div class="detail-content">
                        <h3>상세 설명</h3>
                        <div class="content-body">@post.Content</div>
                        <h3>필요 기술 스택</h3>
                        <div class="tag-cloud">
                            @if (availableTags != null && post.SelectedTagIds != null)
                            {
                                @foreach (var tagId in post.SelectedTagIds)
                                {
                                    var tagName = availableTags.FirstOrDefault(t => t.Id == tagId)?.Name ?? tagId.ToString();
                                    <span class="tag">#@tagName</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </main>

            <aside class="detail-sidebar">
                <div class="card status-card">
                    <h3>모집 현황 (@post.CurrentMembers/@post.MaxMembers)</h3>
                    <div class="member-list">
                        <div class="member-item">
                            <div class="member-info">
                                <span class="member-name">작성자 (팀장)</span>
                            </div>
                        </div>
                        @for (int i = 0; i < post.MaxMembers - post.CurrentMembers; i++)
                        {
                            <div class="member-placeholder">남은 자리</div>
                        }
                    </div>

                    <AuthorizeView>
                        <Authorized>
                            @if (post.IsMyPost)
                            {
                                <button class="btn-outline full-width mb-2" @onclick="HandleEdit">수정하기</button>
                                <button class="btn-outline danger full-width" @onclick="HandleDelete">삭제하기</button>
                            }
                            else
                            {
                                <div class="apply-section">
                                    <textarea class="form-control mb-2" @bind="applyMessage" placeholder="팀장에게 보낼 한마디를 입력하세요."></textarea>
                                    <button class="btn-primary full-width" @onclick="HandleApply" disabled="@isSubmitting">
                                        @(isSubmitting ? "지원 중..." : "지원하기")
                                    </button>
                                </div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <button class="btn-primary full-width" @onclick='() => Nav.NavigateTo("/login")'>로그인하고 지원하기</button>
                        </NotAuthorized>
                    </AuthorizeView>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-2">@errorMessage</div>
                    }
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private GetPostDetailResponse? post;
    private List<Tag>? availableTags;
    private string applyMessage = "";
    private string? errorMessage;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            availableTags = await PostService.GetTagsAsync();
            await LoadPost();
        }
        catch (Exception ex)
        {
            errorMessage = "데이터 로딩 중 오류 발생: " + ex.Message;
        }
    }

    private async Task LoadPost()
    {
        post = await PostService.GetPostDetailAsync(Id);
        if (post?.IsSuccess == false)
        {
            errorMessage = post.Message;
        }
    }

    private async Task HandleApply()
    {
        if (string.IsNullOrWhiteSpace(applyMessage))
        {
            errorMessage = "지원 메시지를 입력해주세요.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await PostService.ApplyPostAsync(Id, new ApplyPostRequest { Message = applyMessage });
            if (result?.IsSuccess == true)
            {
                await LoadPost();
                applyMessage = "";
            }
            else
            {
                errorMessage = result?.Message ?? "지원에 실패했습니다.";
            }
        }
        catch { errorMessage = "서버 통신 오류."; }
        finally { isSubmitting = false; }
    }

    private void HandleEdit() { }
    private void HandleDelete() { }
}

<style>
    .detail-layout { display: grid; grid-template-columns: 1fr 350px; gap: 2rem; margin-top: 2rem; }
    .breadcrumb { font-size: 0.85rem; color: #9ca3af; margin-bottom: 1rem; }
    .detail-title { font-size: 2rem; margin-bottom: 0.5rem; font-weight: 800; }
    .detail-content h3 { margin-top: 2rem; font-size: 1.25rem; font-weight: 700; }
    .detail-content p, .content-body { line-height: 1.7; color: #374151; white-space: pre-wrap; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
    .tag { background: #eff6ff; color: #1e40af; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
    .status-card h3 { margin-bottom: 1.5rem; font-weight: 700; }
    .member-list { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
    .member-item { display: flex; align-items: center; gap: 0.75rem; }
    .member-name { font-weight: 600; font-size: 0.95rem; }
    .member-placeholder { border: 2px dashed #e5e7eb; padding: 0.75rem; text-align: center; border-radius: 0.5rem; color: #9ca3af; font-size: 0.85rem; }
    .full-width { width: 100%; padding: 0.75rem; }
    .mb-2 { margin-bottom: 0.5rem; }
    .mt-2 { margin-top: 0.5rem; }
    .loading-state { text-align: center; padding: 5rem; color: #6b7280; }
    .apply-section textarea { min-height: 100px; resize: none; }
</style>
