@page "/create-post"
@using Microsoft.AspNetCore.Authorization
@using TeamMatching.Web.Client.Services
@using TeamMatching.Shared.DTOs
@using TeamMatching.Shared.Entities
@inject PostClientService PostService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="container">
    <div class="form-card">
        <header class="form-header">
            <button type="button" class="btn-back" @onclick="GoBack">돌아가기</button>
            <h2 class="form-title">모집글 작성</h2>
        </header>

        <EditForm Model="postModel" OnValidSubmit="HandleSubmit" class="post-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="title">프로젝트 제목</label>
                <InputText id="title" class="form-control" @bind-Value="postModel.Title" placeholder="예: 응용소프트웨어실습 3조 팀원 모집" />
                <ValidationMessage For="@(() => postModel.Title)" class="text-danger" />
            </div>

            <div class="form-group">
                <label for="summary">모집글 요약</label>
                <InputTextArea id="summary" class="form-control summary-area" @bind-Value="postModel.Summary" placeholder="목록에서 보일 짧은 소개를 입력하세요." />
                <ValidationMessage For="@(() => postModel.Summary)" class="text-danger" />
            </div>

            <div class="form-row">
                <div class="form-group flex-1">
                    <label for="category">프로젝트 분야</label>
                    <InputSelect id="category" class="form-control" @bind-Value="postModel.Category">
                        <option value="전공 프로젝트">전공 프로젝트</option>
                        <option value="개인 사이드 프로젝트">개인 사이드 프로젝트</option>
                        <option value="공모전/대외활동">공모전/대외활동</option>
                        <option value="기타">기타</option>
                    </InputSelect>
                </div>
                <div class="form-group flex-1">
                    <label for="memberCount">모집 인원</label>
                    <InputNumber id="memberCount" class="form-control" @bind-Value="postModel.MaxMembers" min="1" max="10" />
                </div>
            </div>

            <div class="form-group">
                <label>필요 기술 스택</label>
                <div class="tag-selection">
                    @if (availableTags == null)
                    {
                        <span class="tag-helper">태그를 불러오는 중입니다.</span>
                    }
                    else
                    {
                        @foreach (var tag in availableTags)
                        {
                            <button type="button"
                                    class="tag @(postModel.SelectedTagIds.Contains(tag.Id) ? "active" : "")"
                                    @onclick="() => ToggleTag(tag.Id)">
                                #@tag.Name
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="form-group">
                <label for="description">상세 설명</label>
                <InputTextArea id="description" class="form-control text-area"
                               @bind-Value="postModel.Content"
                               placeholder="프로젝트 목표, 진행 방식, 원하는 팀원 조건 등을 자세히 입력하세요." />
                <ValidationMessage For="@(() => postModel.Content)" class="text-danger" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="form-actions">
                <button type="button" class="btn-secondary" @onclick="GoBack" disabled="@isSubmitting">취소</button>
                <button type="submit" class="btn-primary" disabled="@isSubmitting">
                    @(isSubmitting ? "등록 중..." : "등록하기")
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreatePostRequest postModel = new();
    private List<Tag>? availableTags;
    private string? errorMessage;
    private bool isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        postModel.Category = "전공 프로젝트";
        postModel.MaxMembers = 2;
        try { availableTags = await PostService.GetTagsAsync(); }
        catch { availableTags = []; }
    }

    private void ToggleTag(int tagId)
    {
        if (postModel.SelectedTagIds.Contains(tagId)) postModel.SelectedTagIds.Remove(tagId);
        else postModel.SelectedTagIds.Add(tagId);
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            var result = await PostService.CreatePostAsync(postModel);
            if (result?.IsSuccess == true) Nav.NavigateTo("/");
            else errorMessage = result?.Message ?? "작성 실패";
        }
        catch { errorMessage = "서버 통신 오류"; }
        finally { isSubmitting = false; }
    }

    private void GoBack() => Nav.NavigateTo("/");
}

<style>
    .form-card { max-width: 800px; margin: 3rem auto; padding: 2.5rem; background: white; border: 1px solid #e5e7eb; border-radius: 1rem; }
    .form-header { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2.5rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; }
    .btn-back { background: none; border: none; color: #6b7280; cursor: pointer; font-size: 1rem; font-weight: 600; }
    .form-title { font-size: 1.5rem; font-weight: 700; margin: 0; }
    .post-form { display: flex; flex-direction: column; gap: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-row { display: flex; gap: 1.5rem; }
    .flex-1 { flex: 1; }
    .form-control { padding: 0.875rem 1rem; border: 1px solid #e5e7eb; border-radius: 0.5rem; }
    .summary-area { min-height: 90px; }
    .text-area { min-height: 250px; }
    .tag-selection { display: flex; flex-wrap: wrap; gap: 0.5rem; background: #f9fafb; padding: 1rem; border-radius: 0.5rem; border: 1px dashed #e5e7eb; }
    .tag { border: 1px solid transparent; border-radius: 999px; background: #f3f4f6; color: #4b5563; cursor: pointer; font-size: 0.9rem; padding: 0.35rem 0.75rem; }
    .tag.active { background: #eff6ff; border-color: #3b82f6; color: #2563eb; }
    .form-actions { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem; padding-top: 2rem; border-top: 1px solid #e5e7eb; }
    .btn-primary { background: #3b82f6; color: white; border: none; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; }
    .btn-secondary { background: #f3f4f6; border: 1px solid #d1d5db; padding: 0.75rem 2rem; border-radius: 0.5rem; font-weight: 600; cursor: pointer; }
    .alert-danger { background: #fef2f2; color: #991b1b; padding: 0.75rem; border-radius: 0.5rem; }
</style>
